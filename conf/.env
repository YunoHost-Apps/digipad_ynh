DOMAIN="https://__DOMAIN__"
PORT="__PORT__"
# Utilisation d'un reverse proxy / 0 ou 1 / 0 par défaut
REVERSE_PROXY=0
# Utilisation de node.js en cluster / 0 ou 1 / 0 par défaut
NODE_CLUSTER=
# Utilisation par le serveur des early hints et du code de statut 103 / 0 ou 1 / 0 par défaut
EARLY_HINTS=

DB_HOST="localhost"
# Mot de passe de la base de données Redis
DB_PWD=
DB_PORT="6379"
SESSION_KEY="__KEY__"
# Durée de la session de connexion des utilisateurs en millisecondes
SESSION_DURATION="3600000"
# Utilisation d'une base de données postgresql pour décharger la base de données Redis / 0 ou 1 / 0 par défaut
PG_DB="1" 
PG_DB_USER="__DB_USER__"
PG_DB_PWD="__DB_PWD__"
PG_DB_HOST="localhost"
PG_DB_PORT="5432"
PG_DB_NAME="__DB_NAME__"

# Lien vers un serveur Etherpad pour les documents collaboratifs
VITE_ETHERPAD=
VITE_ETHERPAD_API_KEY=
VITE_PIXABAY_API_KEY=

VITE_UPLOAD_LIMIT="100"
# Types de fichiers autorisés pour le téléversement / par défaut : .jpg,.jpeg,.png,.gif,.mp4,.m4v,.mp3,.m4a,.ogg,.wav,.pdf,.ppt,.pptx,.odp,.doc,.docx,.odt,.ods,.odg,.xls,.xlsx
VITE_UPLOAD_FILE_TYPES=

# Nombre maximum de pads par compte utilisateur
VITE_PAD_LIMIT=__PAD_LIMIT__
# Auitoriser la création de pads sans compte
VITE_PAD_WITHOUT_ACCOUNT=__WITHOUT_ACCOUNT__
# Autoriser la création de comptes :
VITE_CREATE_ACCOUNT=__CREATE_ACCOUNT__
# Validation de l'inscription par email / 0 ou 1 / 0 par défaut
ACCOUNT_VALIDATION="__ACCOUNT_VALIDATION__"
VITE_ADMIN_PASSWORD="__PASSWORD__"

# Régularité de la tâche cron pour supprimer les fichiers temporaires / 59 23 * * Saturday par défaut
CRON_TASK_DATE= 
EMAIL_HOST=localhost
EMAIL_ADDRESS="__APP__@__DOMAIN__"
EMAIL_PASSWORD="__MAIL_PWD__"
EMAIL_PORT="25"
EMAIL_SECURE=false

# Lien vers un serveur Matomo
VITE_MATOMO= 
# id de site sur le serveur Matomo / 1 par défaut
VITE_MATOMO_SITE_ID= 
# id de pad à partir de laquelle les fichiers seront enregistrés dans un dossier monté NFS - environ 170 000 pour 1 To de capacité disque
VITE_NFS_PAD_NUMBER=
# Nom du dossier monté NFS, obligatoirement situé dans le dossier /static/. ex : /static/nfs
VITE_NFS_FOLDER=
# Id de pad à partir de laquelle les fichiers seront enregistrés dans un 2e dossier monté NFS
VITE_NFS2_PAD_NUMBER=
# (nom du dossier monté NFS, obligatoirement situé dans le dossier /static/. ex : /static/nfs2)... (NF3, NFS4, NFS5, NFS6)
VITE_NFS2_FOLDER= 
# (lien vers le script fourni par Umami pour l'analyse de trafic)
UMAMI_SCRIPT_URL=
# (id de site sur le serveur Umami)
UMAMI_WEBSITE_ID 

# Domaines autorisés pour api serveur. ex : ladigitale.dev,example.com / par défaut *
AUTHORIZED_DOMAINS=*
# Pourcentage d'espace libre en dessous duquel une alerte est affichée et le téléversement de fichiers empêché / 10 par défaut
ALERT_AVAILABLE_SPACE=

# Type de stockage pour les fichiers - fs ou s3 / fs - filestorage par défaut
VITE_STORAGE=
# Lien public vers les contenus du conteneur d'objets S3
VITE_S3_PUBLIC_LINK=
S3_SERVER_TYPE=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_BUCKET=
# Nombre maximum de sockets pour httpsAgent du client S3
S3_MAX_SOCKETS=
# Lien vers une visionneuse pour les documents MS Office / téléchargement du fichier par défaut
VITE_DOCX_VIEWER= 
# lien vers un serveur externe pour le traitement des téléversements / équivalent à DOMAIN par défaut
UPLOAD_HOST=
# Clé pour decrypter les données Digidrive / uniquement nécessaire si Digidrive est utilisé
ENCRYPTION_KEY= 
#  lien vers les mentions légales
VITE_LEGAL_TERMS_LINK
